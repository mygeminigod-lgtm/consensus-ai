# ==============================================================================
# Consensus AI — Environment Configuration Example
# Never commit active API keys to source control.
# Copy this file to .env.local to configure providers for local development.
# ==============================================================================

# Google Gemini API
# Get your key at: https://aistudio.google.com/
GOOGLE_AI_API_KEY=

# OpenAI API (GPT-4o, GPT-4o-mini)
# Get your key at: https://platform.openai.com/
OPENAI_API_KEY=

# Anthropic Claude API (Claude 3.5 Sonnet)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# DeepSeek API (DeepSeek-V3, DeepSeek-Reasoner)
# Get your key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Mistral AI API (Mistral Large)
# Get your key at: https://console.mistral.ai/
MISTRAL_API_KEY=

# Perplexity API (Sonar, Sonar Pro)
# Get your key at: https://docs.perplexity.ai/
PERPLEXITY_API_KEY=

# xAI API (Grok 2)
# Get your key at: https://x.ai/api
XAI_API_KEY=

# Optional: Default Verification Mode
NEXT_PUBLIC_DEFAULT_MODE=balanced
